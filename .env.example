# ── Cliente (públicas, se pueden exponer al navegador) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Autenticación Clerk (claves de la MISMA instancia) ──────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Cópiala completa con el botón de copiar de Clerk; la versión truncada (sk_test_S…m3ZE) no sirve.
CLERK_SECRET_KEY=

# ── Solo servidor: guardado de datos en Supabase (/api/user-state) ──────────────
# Obligatoria para la sincronización en la nube. NUNCA con prefijo NEXT_PUBLIC_.
# Supabase → Settings → API Keys → clave secreta (sb_secret_…) o service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: si no existe se usa NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
